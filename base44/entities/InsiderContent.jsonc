{
  "name": "InsiderContent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Content title"
    },
    "slug": {
      "type": "string",
      "description": "URL slug for sharing"
    },
    "category": {
      "type": "string",
      "enum": [
        "tip",
        "trick",
        "wealth",
        "secret"
      ],
      "default": "tip",
      "description": "Content category for filtering and display"
    },
    "excerpt": {
      "type": "string",
      "description": "Short summary for cards and feeds"
    },
    "content_markdown": {
      "type": "string",
      "description": "Full content in markdown"
    },
    "image_url": {
      "type": "string",
      "description": "Optional featured image URL"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Sort order within category"
    },
    "publish_date": {
      "type": "string",
      "format": "date-time",
      "description": "Publish date for feed ordering"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Show in featured carousel"
    },
    "read_time_minutes": {
      "type": "number",
      "default": 3,
      "description": "Estimated read time"
    }
  },
  "required": [
    "title",
    "slug",
    "category",
    "excerpt",
    "content_markdown",
    "publish_date"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}