{
  "name": "SwarmRun",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "prompt": {
      "type": "string",
      "maxLength": 12000
    },
    "preset": {
      "type": "string"
    },
    "runtime": {
      "type": "string",
      "enum": [
        "native",
        "chatgpt"
      ]
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "agent_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "dispatching",
        "submitted",
        "needs_attention",
        "awaiting_chatgpt"
      ],
      "default": "draft"
    }
  },
  "required": [
    "title",
    "prompt",
    "runtime",
    "agent_ids"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}