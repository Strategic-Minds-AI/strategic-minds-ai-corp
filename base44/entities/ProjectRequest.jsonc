{
  "name": "ProjectRequest",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Resolved"
      ],
      "default": "Open"
    },
    "reply": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "client_id",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}