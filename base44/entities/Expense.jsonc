{
  "name": "Expense",
  "type": "object",
  "properties": {
    "vendor": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "advertising",
        "software",
        "contractors",
        "travel",
        "office",
        "utilities",
        "other"
      ],
      "default": "other"
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "account_id": {
      "type": "string"
    },
    "deal_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "paid"
      ],
      "default": "pending"
    },
    "receipt_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "vendor",
    "amount"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}