{
  "name": "EnhancementJob",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "criterion_id": {
      "type": "string"
    },
    "route": {
      "type": "string",
      "enum": [
        "builder",
        "admin",
        "worker"
      ]
    },
    "request_id": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "brief_ready",
        "planning",
        "plan_ready",
        "plan_failed"
      ]
    },
    "plan": {
      "type": "string",
      "maxLength": 16000
    },
    "error": {
      "type": "string",
      "maxLength": 400
    },
    "plan_started_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "owner_id",
    "criterion_id",
    "route",
    "request_id",
    "revision",
    "status"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    }
  }
}