{
  "name": "ClientInfrastructure",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "code",
          "data"
        ]
      }
    },
    "github_repo": {
      "type": "string"
    },
    "github_url": {
      "type": "string"
    },
    "vercel_id": {
      "type": "string"
    },
    "vercel_url": {
      "type": "string"
    },
    "railway_id": {
      "type": "string"
    },
    "railway_url": {
      "type": "string"
    },
    "railway_service_id": {
      "type": "string"
    },
    "supabase_ref": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "client_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}