{
  "name": "ClientInfrastructure",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "code",
          "data"
        ]
      }
    },
    "stack_type": {
      "type": "string",
      "enum": [
        "static_site",
        "vite_app",
        "fullstack",
        "backend_api",
        "mobile_app"
      ],
      "default": "static_site",
      "description": "What kind of system is being provisioned"
    },
    "github_repo": {
      "type": "string"
    },
    "github_url": {
      "type": "string"
    },
    "vercel_id": {
      "type": "string"
    },
    "vercel_url": {
      "type": "string"
    },
    "railway_id": {
      "type": "string"
    },
    "railway_url": {
      "type": "string"
    },
    "railway_service_id": {
      "type": "string"
    },
    "supabase_ref": {
      "type": "string"
    },
    "supabase_url": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "description": "Custom domain configured for this system"
    },
    "domain_status": {
      "type": "string",
      "enum": [
        "pending",
        "available",
        "configured",
        "purchased",
        "failed"
      ],
      "default": "pending"
    },
    "provision_status": {
      "type": "string",
      "enum": [
        "pending",
        "github_ready",
        "vercel_ready",
        "railway_ready",
        "supabase_ready",
        "domain_ready",
        "complete",
        "failed"
      ],
      "default": "pending"
    },
    "deployment_url": {
      "type": "string"
    },
    "env_vars": {
      "type": "string",
      "maxLength": 5000,
      "description": "JSON array of env var keys that have been set"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "client_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}