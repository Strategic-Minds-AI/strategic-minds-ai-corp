{
  "name": "AgentTask",
  "type": "object",
  "properties": {
    "agent_name": {
      "type": "string",
      "description": "Which agent owns this task"
    },
    "task_type": {
      "type": "string",
      "description": "Task category (e.g. google_connect, social_connect, build_system, growth_audit)"
    },
    "title": {
      "type": "string",
      "description": "Human-readable task title"
    },
    "description": {
      "type": "string",
      "description": "Task details or JSON payload"
    },
    "priority": {
      "type": "string",
      "enum": [
        "urgent",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "autonomous": {
      "type": "boolean",
      "default": false,
      "description": "Whether the autonomous worker can execute this without human approval"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "needs_approval",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "domain": {
      "type": "string",
      "description": "Associated domain if applicable"
    },
    "result": {
      "type": "string",
      "description": "Execution result or output"
    },
    "claim_token": {
      "type": "string",
      "description": "One-time token assigned when a sandbox claims this task. Required to report results."
    },
    "claimed_by_sandbox_id": {
      "type": "string",
      "description": "ID of the sandbox that claimed this task"
    },
    "lease_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the task claim lease expires. Expired leases can be re-claimed by other sandboxes."
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the sandbox started executing this task"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the sandbox finished executing this task"
    },
    "batch_id": {
      "type": "string",
      "description": "Owning BatchOperation"
    },
    "site_key": {
      "type": "string",
      "description": "Stable site identifier within a batch"
    },
    "phase": {
      "type": "string",
      "description": "Factory stage: source_truth, research, creative, mockup_lock, build, validate, repair, grow, receipt"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Task IDs that must complete before this task is eligible"
    },
    "swarm_role": {
      "type": "string",
      "description": "Swarm Nexus specialist role"
    },
    "checkpoint_key": {
      "type": "string",
      "description": "Wave/checkpoint identifier"
    }
  },
  "required": [
    "agent_name",
    "title",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
