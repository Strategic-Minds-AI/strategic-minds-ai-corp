{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "assistant_instructions": {
      "type": "string",
      "maxLength": 15000,
      "description": "Personal instructions for the agency assistant"
    }
  },
  "required": [
    "role"
  ]
}