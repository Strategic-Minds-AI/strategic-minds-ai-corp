{
  "name": "SmsConversation",
  "type": "object",
  "properties": {
    "phone_number": {
      "type": "string",
      "description": "The remote phone number in E.164 format"
    },
    "contact_name": {
      "type": "string",
      "description": "Optional friendly name for this contact"
    },
    "last_message_preview": {
      "type": "string",
      "description": "Short preview of the most recent message",
      "maxLength": 200
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "unread_count": {
      "type": "number",
      "default": 0
    },
    "channel": {
      "type": "string",
      "enum": [
        "sms",
        "voice"
      ],
      "default": "sms"
    }
  },
  "required": [
    "phone_number",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}