{
  "name": "BenchmarkRun",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "run_nonce": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "probe_id": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          },
          "verified_at": {
            "type": "string"
          }
        },
        "required": [
          "probe_id",
          "passed",
          "detail",
          "verified_at"
        ]
      }
    },
    "signature": {
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "revision",
    "run_nonce",
    "observed_at",
    "observations",
    "signature"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    }
  }
}