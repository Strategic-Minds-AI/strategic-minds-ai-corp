{
  "name": "Tag",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Tag name"
    },
    "color": {
      "type": "string",
      "default": "#0066FF",
      "description": "Tag color hex"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}