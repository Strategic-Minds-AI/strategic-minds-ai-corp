{
  "name": "SmsMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "Reference to SmsConversation"
    },
    "from_number": {
      "type": "string",
      "description": "Sender phone number in E.164"
    },
    "to_number": {
      "type": "string",
      "description": "Recipient phone number in E.164"
    },
    "body": {
      "type": "string",
      "maxLength": 5000,
      "description": "Message body text"
    },
    "media_urls": {
      "type": "string",
      "maxLength": 5000,
      "description": "JSON array of MMS media URLs"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "description": "Whether the message was received or sent"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "sms",
        "mms"
      ],
      "default": "sms"
    },
    "twilio_sid": {
      "type": "string",
      "description": "Twilio message SID"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "sent",
        "queued",
        "failed",
        "delivered",
        "undelivered"
      ],
      "default": "received"
    },
    "agent_generated": {
      "type": "boolean",
      "default": false,
      "description": "True if the outbound message was auto-generated by the AI agent"
    }
  },
  "required": [
    "conversation_id",
    "from_number",
    "to_number",
    "direction"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}