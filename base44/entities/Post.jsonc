{
  "type": "object",
  "name": "Post",
  "properties": {
    "display_order": {
      "type": "number",
      "description": "Display order"
    },
    "title": {
      "type": "string",
      "description": "Post title"
    },
    "slug": {
      "type": "string",
      "description": "URL slug"
    },
    "publish_date": {
      "type": "string",
      "description": "Publish date",
      "format": "date-time"
    },
    "excerpt": {
      "type": "string",
      "description": "Short summary"
    },
    "content_markdown": {
      "type": "string",
      "description": "Post content",
      "format": "richtext"
    },
    "image_url": {
      "type": "string",
      "description": "Featured image URL"
    },
    "image_alt": {
      "type": "string",
      "description": "Featured image alt text"
    },
    "author_name": {
      "type": "string",
      "description": "Author name"
    },
    "author_image_url": {
      "type": "string",
      "description": "Author image URL"
    },
    "categories": {
      "type": "string",
      "description": "Comma-separated categories"
    }
  },
  "required": [
    "display_order",
    "title",
    "slug",
    "publish_date",
    "excerpt",
    "content_markdown"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}