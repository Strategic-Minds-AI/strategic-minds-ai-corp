{
  "name": "WebPack",
  "type": "object",
  "description": "A website pack uploaded for ingestion. Can be either a design mockup image (vision AI generates HTML) or a full HTML pack uploaded directly by GPT/external systems.",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    },
    "name": {
      "type": "string",
      "description": "Name/label for this web pack"
    },
    "kind": {
      "type": "string",
      "enum": [
        "design_image",
        "web_pack",
        "logo_pack",
        "brand_pack"
      ],
      "default": "design_image",
      "description": "Type of pack: design_image = mockup to convert, web_pack = full HTML upload"
    },
    "image_url": {
      "type": "string",
      "description": "URL of the uploaded design mockup image (for design_image packs)"
    },
    "preview_html": {
      "type": "string",
      "description": "Full HTML content for web_pack uploads from GPT/external"
    },
    "brand_tokens": {
      "type": "object",
      "description": "Design tokens: colors, fonts, spacing, etc.",
      "properties": {
        "primaryColor": {
          "type": "string"
        },
        "accentColor": {
          "type": "string"
        },
        "fontHeading": {
          "type": "string"
        },
        "fontBody": {
          "type": "string"
        },
        "style": {
          "type": "string"
        }
      }
    },
    "manifest": {
      "type": "object",
      "description": "File manifest: pages, assets, routes included in the pack"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "gpt_sync",
        "api",
        "auto_build"
      ],
      "default": "manual",
      "description": "How this pack was submitted"
    },
    "submitted_by_label": {
      "type": "string",
      "description": "Label identifying who submitted (e.g. ChatGPT, admin name)"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "analyzing",
        "generating",
        "deploying",
        "deployed",
        "failed",
        "pending_review"
      ],
      "default": "queued",
      "description": "Build status"
    },
    "generated_html": {
      "type": "string",
      "description": "The HTML content (generated from design image, or uploaded directly for web_pack)"
    },
    "vercel_url": {
      "type": "string",
      "description": "Live Vercel URL after deployment"
    },
    "vercel_project_id": {
      "type": "string",
      "description": "Vercel project ID for the deployed site"
    },
    "error": {
      "type": "string",
      "description": "Error message if the build failed"
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Execution log entries for debugging and auditability"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}