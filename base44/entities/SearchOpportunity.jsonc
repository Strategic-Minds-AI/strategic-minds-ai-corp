{
  "name": "SearchOpportunity",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description (up to 1000 characters)",
      "maxLength": 1000
    },
    "business_id": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "cluster": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "demand_score": {
      "type": "number"
    },
    "commercial_score": {
      "type": "number"
    },
    "serp_weakness_score": {
      "type": "number"
    },
    "local_fit": {
      "type": "number"
    },
    "tool_opportunity": {
      "type": "string"
    },
    "overall_score": {
      "type": "number"
    },
    "evidence": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "queued",
        "built",
        "dismissed"
      ],
      "default": "open"
    }
  },
  "required": [
    "query"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}