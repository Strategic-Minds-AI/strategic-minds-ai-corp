{
  "name": "BatchOperation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Batch name"
    },
    "batch_size": {
      "type": "number",
      "default": 10,
      "description": "Number of sites in batch"
    },
    "template": {
      "type": "object",
      "description": "Template spec with variables"
    },
    "variables": {
      "type": "string",
      "description": "JSON array of variable sets"
    },
    "deploy_targets": {
      "type": "string",
      "description": "Comma-separated deploy targets (railway, github)"
    },
    "google_connect": {
      "type": "boolean",
      "default": true
    },
    "social_connect": {
      "type": "boolean",
      "default": true
    },
    "video_generate": {
      "type": "boolean",
      "default": false
    },
    "content_optimize": {
      "type": "boolean",
      "default": true
    },
    "free_mode": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "complete",
        "awaiting_approval",
        "failed"
      ],
      "default": "queued"
    },
    "sites": {
      "type": "number",
      "default": 0
    },
    "tasks_dispatched": {
      "type": "number",
      "default": 0
    },
    "swarm_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Use Apex-governed Swarm Nexus wave execution"
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "shadow",
        "execute"
      ],
      "default": "shadow",
      "description": "shadow compiles/validates only; execute may promote approved work"
    },
    "swarm_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 3
    },
    "wave_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 250,
      "default": 10
    },
    "source_truth_version": {
      "type": "string"
    },
    "pipeline_version": {
      "type": "string",
      "default": "swarm-nexus-website-factory-v1"
    },
    "triage_level": {
      "type": "string",
      "enum": [
        "single",
        "small",
        "fleet",
        "mass",
        "mega"
      ]
    },
    "sites_materialized": {
      "type": "integer",
      "default": 0
    },
    "next_site_index": {
      "type": "integer",
      "default": 1
    },
    "quality_gate": {
      "type": "string",
      "enum": [
        "PENDING",
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNKNOWN"
      ],
      "default": "PENDING"
    },
    "checkpoint": {
      "type": "object",
      "description": "Durable wave checkpoint and synthesis metadata"
    }
  },
  "required": [
    "name",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
