{
  "name": "AgentSecret",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique identifier the agent references (e.g. OPENAI_API_KEY, STRIPE_SECRET_KEY)"
    },
    "encrypted_value": {
      "type": "string",
      "description": "AES-256-GCM envelope (JSON) \u2014 ciphertext + iv, encrypted with the server master key"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "category": {
      "type": "string",
      "enum": [
        "api_key",
        "token",
        "password",
        "connection_string",
        "webhook_secret",
        "other"
      ],
      "default": "api_key"
    },
    "last_used": {
      "type": "string",
      "format": "date-time"
    },
    "used_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "encrypted_value"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}