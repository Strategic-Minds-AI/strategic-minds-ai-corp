{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "participant_identity": {
      "type": "string",
      "description": "Phone number or email of the other party"
    },
    "contact_name": {
      "type": "string",
      "description": "Friendly name for this contact"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sms",
          "mms",
          "whatsapp",
          "voice",
          "email"
        ]
      },
      "default": [
        "sms"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "idle",
        "closed",
        "archived"
      ],
      "default": "active"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_message_preview": {
      "type": "string",
      "maxLength": 200
    },
    "unread_count": {
      "type": "number",
      "default": 0
    },
    "summary": {
      "type": "string",
      "description": "AI-generated conversation summary"
    },
    "assigned_agent_id": {
      "type": "string",
      "description": "AgentPersona ID assigned to this conversation"
    }
  },
  "required": [
    "participant_identity",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}