{
  "name": "Pipeline",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Pipeline name"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Ordered list of stage names"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}