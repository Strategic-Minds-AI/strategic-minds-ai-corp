{
  "name": "Campaign",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "sms",
        "mms",
        "voice",
        "whatsapp"
      ],
      "default": "sms"
    },
    "message_template": {
      "type": "string"
    },
    "voice_script": {
      "type": "string"
    },
    "persona_id": {
      "type": "string",
      "description": "AgentPersona assigned to this campaign"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "running",
        "paused",
        "completed",
        "cancelled"
      ],
      "default": "draft"
    },
    "schedule_type": {
      "type": "string",
      "enum": [
        "immediate",
        "scheduled",
        "recurring"
      ],
      "default": "immediate"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "throttle_per_sec": {
      "type": "integer",
      "default": 10,
      "description": "Max messages per second to prevent carrier blocking"
    },
    "total_recipients": {
      "type": "number",
      "default": 0
    },
    "sent_count": {
      "type": "number",
      "default": 0
    },
    "delivered_count": {
      "type": "number",
      "default": 0
    },
    "failed_count": {
      "type": "number",
      "default": 0
    },
    "opt_out_count": {
      "type": "number",
      "default": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name",
    "channel",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}