{
  "name": "Lead",
  "type": "object",
  "properties": {
    "form_type": {
      "type": "string",
      "enum": [
        "contact",
        "quotation",
        "newsletter",
        "newsletter_v2",
        "pricing",
        "search",
        "client_onboarding"
      ],
      "description": "Which form the submission came from"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "plan_title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "business": {
      "type": "string",
      "maxLength": 5000
    },
    "products_services": {
      "type": "string",
      "maxLength": 5000
    },
    "location_service_area": {
      "type": "string",
      "maxLength": 5000
    },
    "ideal_customer_goal": {
      "type": "string",
      "maxLength": 5000
    },
    "preferred_visual_style": {
      "type": "string",
      "maxLength": 5000
    },
    "drive_folder_id": {
      "type": "string"
    },
    "drive_folder_url": {
      "type": "string"
    },
    "intake_source_file_id": {
      "type": "string"
    },
    "provisioning_status": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "failed"
      ],
      "default": "pending"
    },
    "provisioning_error": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "form_type"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
