{
  "name": "CatalogItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "one_time",
        "subscription",
        "quote"
      ],
      "description": "Purchase type: one-time payment, recurring subscription, or custom quote"
    },
    "price_cents": {
      "type": "number",
      "description": "Price in the currency's smallest unit (e.g. cents for USD)"
    },
    "currency": {
      "type": "string",
      "default": "usd"
    },
    "interval": {
      "type": "string",
      "enum": [
        "month",
        "year"
      ],
      "description": "Billing interval for subscriptions"
    },
    "category": {
      "type": "string",
      "enum": [
        "strategy",
        "automation",
        "knowledge",
        "data",
        "marketing",
        "search",
        "crm",
        "websites",
        "software",
        "training",
        "governance",
        "managed"
      ],
      "description": "Service category for filtering and grouping on the pricing page"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "kind",
    "active"
  ],
  "rls": {
    "read": true,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}