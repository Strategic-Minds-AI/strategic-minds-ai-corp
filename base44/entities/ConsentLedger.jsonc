{
  "name": "ConsentLedger",
  "type": "object",
  "properties": {
    "phone_number": {
      "type": "string",
      "description": "E.164 phone number of the person who consented or opted out"
    },
    "email": {
      "type": "string",
      "description": "Email address if consent was given via email channel"
    },
    "channel": {
      "type": "string",
      "enum": [
        "sms",
        "mms",
        "whatsapp",
        "voice",
        "email",
        "all"
      ],
      "default": "all",
      "description": "Which channel(s) this consent event applies to"
    },
    "consent_type": {
      "type": "string",
      "enum": [
        "opt_in",
        "opt_out",
        "re_opt_in"
      ],
      "default": "opt_in",
      "description": "Type of consent event: initial opt-in, opt-out, or re-opt-in after opting out"
    },
    "source": {
      "type": "string",
      "enum": [
        "keyword",
        "web_form",
        "voice",
        "manual",
        "api",
        "unsubscribe_page",
        "whatsapp_keyword"
      ],
      "default": "keyword",
      "description": "How the consent event was triggered"
    },
    "consent_text_version": {
      "type": "string",
      "description": "Version identifier of the policy text the user consented to (e.g. 2026-10-06-v1)"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address of the person when consent was recorded (web form sources only)"
    },
    "user_agent": {
      "type": "string",
      "description": "Browser user agent string (web form sources only)"
    },
    "keyword_used": {
      "type": "string",
      "description": "The keyword that triggered this consent event (START, YES, STOP, UNSTOP, etc.)"
    },
    "provider_message_id": {
      "type": "string",
      "description": "Twilio/Telnyx message SID if consent was triggered by an inbound keyword"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "expired"
      ],
      "default": "active",
      "description": "Whether this consent record is currently in effect"
    },
    "notes": {
      "type": "string",
      "maxLength": 500,
      "description": "Additional context about this consent event"
    }
  },
  "required": [
    "phone_number",
    "consent_type",
    "source",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}