{
  "name": "Sandbox",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Sandbox name"
    },
    "environment": {
      "type": "string",
      "enum": [
        "local",
        "railway"
      ],
      "default": "local",
      "description": "Where the sandbox runs"
    },
    "status": {
      "type": "string",
      "enum": [
        "creating",
        "active",
        "paused",
        "error",
        "deleted"
      ],
      "default": "creating"
    },
    "railway_environment_id": {
      "type": "string",
      "description": "Railway environment ID"
    },
    "railway_project_id": {
      "type": "string",
      "description": "Railway project ID"
    },
    "config": {
      "type": "string",
      "description": "JSON configuration for the sandbox"
    },
    "url": {
      "type": "string",
      "description": "Sandbox URL if deployed"
    },
    "agent_name": {
      "type": "string",
      "description": "Which agent this sandbox is for"
    },
    "description": {
      "type": "string",
      "description": "Sandbox purpose"
    },
    "api_key_hash": {
      "type": "string",
      "description": "SHA-256 hash of the sandbox API key. Raw key is never stored."
    },
    "key_prefix": {
      "type": "string",
      "description": "First 10 chars of the raw key for display identification only"
    },
    "last_heartbeat_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time the sandbox worker checked in via heartbeat"
    },
    "health_status": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "offline",
        "unknown"
      ],
      "default": "unknown",
      "description": "Health status derived from heartbeat staleness"
    },
    "current_task_id": {
      "type": "string",
      "description": "ID of the task currently being executed by this sandbox"
    },
    "cycles_completed": {
      "type": "number",
      "default": 0,
      "description": "Total number of task cycles this sandbox has completed"
    },
    "last_error": {
      "type": "string",
      "description": "Last error message from the sandbox worker"
    }
  },
  "required": [
    "name",
    "environment",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}