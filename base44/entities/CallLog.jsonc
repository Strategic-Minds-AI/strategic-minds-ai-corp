{
  "name": "CallLog",
  "type": "object",
  "properties": {
    "call_sid": {
      "type": "string",
      "description": "Twilio call SID"
    },
    "from_number": {
      "type": "string",
      "description": "Caller phone number in E.164"
    },
    "to_number": {
      "type": "string",
      "description": "Called phone number in E.164"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "default": "inbound"
    },
    "status": {
      "type": "string",
      "enum": [
        "ringing",
        "in-progress",
        "completed",
        "failed",
        "busy",
        "no-answer",
        "canceled"
      ],
      "default": "ringing"
    },
    "duration_seconds": {
      "type": "number",
      "default": 0
    },
    "recording_url": {
      "type": "string",
      "description": "URL to the call recording if available"
    },
    "transcript": {
      "type": "string",
      "maxLength": 20000,
      "description": "JSON array of conversation turns during the call"
    },
    "agent_summary": {
      "type": "string",
      "maxLength": 2000,
      "description": "Summary of the call generated by the agent"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "call_sid",
    "from_number",
    "to_number",
    "direction",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}