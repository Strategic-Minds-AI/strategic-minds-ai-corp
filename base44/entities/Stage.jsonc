{
  "name": "Stage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Stage name"
    },
    "pipeline_id": {
      "type": "string",
      "description": "Reference to Pipeline"
    },
    "order": {
      "type": "number",
      "description": "Display order"
    },
    "probability": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 100
    }
  },
  "required": [
    "name",
    "pipeline_id",
    "order"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}