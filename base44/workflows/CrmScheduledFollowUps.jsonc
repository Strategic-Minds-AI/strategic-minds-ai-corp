{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "crm_scheduled_follow_ups",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_follow_ups": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "crmFollowUps",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send due follow-ups",
            "description": "Scheduled messages only"
          }
        }
      }
    ]
  },
  "name": "CRM Scheduled Follow-ups",
  "description": "Checks due CRM follow-ups every 15 minutes and sends scheduled emails through the agency Gmail account."
}