{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_encrypted_vault_backup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "encrypt_and_save": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "vaultBackup",
            "args": {
              "action": "create"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Encrypt and save vault backup",
            "description": "Private agency Drive \u00b7 Admin authentication required"
          }
        }
      }
    ]
  },
  "name": "Daily Encrypted Vault Backup",
  "description": "Back up the authenticated admin's own vault references and access-key records to the private agency Drive folder at 02:00 UTC. Encrypt before uploading; deny invocation without authenticated admin access.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 2 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}