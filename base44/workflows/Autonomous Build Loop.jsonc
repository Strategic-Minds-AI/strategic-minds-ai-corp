{
  "name": "Autonomous Build Loop",
  "description": "Self-driving build loop \u2014 picks the next pending AutoBuild with auto_advance enabled, processes its current step, validates, and advances. Runs every 30 minutes.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 30,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "autonomous_build_loop",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_build": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runAutonomousBuild",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Run autonomous build cycle",
            "description": "Process up to 3 eligible AutoBuild records with auto_advance enabled"
          }
        }
      }
    ]
  }
}