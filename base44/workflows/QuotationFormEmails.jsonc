{
  "name": "Quotation Form Emails",
  "description": "When a quotation-form Lead is created, email the site owner and auto-reply to the lead.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Lead",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.form_type == \"quotation\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "quotation_form_emails",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_emails": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "send-form-emails",
            "args": {
              "form_type": "quotation",
              "name": "${ .trigger.data.name }",
              "email": "${ .trigger.data.email }",
              "phone": "${ .trigger.data.phone }",
              "website": "${ .trigger.data.website }",
              "service": "${ .trigger.data.service }",
              "message": "${ .trigger.data.message }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send quotation emails",
            "description": "Owner + lead auto-reply"
          }
        }
      }
    ]
  }
}