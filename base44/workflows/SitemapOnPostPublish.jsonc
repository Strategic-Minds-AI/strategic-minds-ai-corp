{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sitemap_on_post",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_sitemap": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateSitemap"
          },
          "then": "end",
          "x-base44": {
            "title": "Regenerate sitemap",
            "description": "Rebuild and submit sitemap to Google"
          }
        }
      }
    ]
  },
  "description": "Regenerates and submits the sitemap when a blog post is created or updated.",
  "name": "Sitemap on Post Publish",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Post"
    }
  }
}