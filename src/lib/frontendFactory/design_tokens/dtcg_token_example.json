{
  "primitive": {
    "color": {
      "blue-600": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.145, 0.388, 0.922], "hex": "#2563EB" }
      },
      "slate-950": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.008, 0.024, 0.071], "hex": "#020617" }
      },
      "white": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" }
      },
      "slate-50": {
        "$type": "color",
        "$value": { "colorSpace": "srgb", "components": [0.973, 0.98, 0.988], "hex": "#F8FAFC" }
      }
    },
    "space": {
      "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
      "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
      "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "6": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
      "8": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } }
    }
  },
  "semantic": {
    "color": {
      "background-canvas": { "$type": "color", "$value": "{primitive.color.slate-50}" },
      "surface-base": { "$type": "color", "$value": "{primitive.color.white}" },
      "text-primary": { "$type": "color", "$value": "{primitive.color.slate-950}" },
      "action-primary": { "$type": "color", "$value": "{primitive.color.blue-600}" },
      "action-on-primary": { "$type": "color", "$value": "{primitive.color.white}" }
    },
    "spacing": {
      "control-gap": { "$type": "dimension", "$value": "{primitive.space.2}" },
      "card-padding": { "$type": "dimension", "$value": "{primitive.space.4}" },
      "section-gap": { "$type": "dimension", "$value": "{primitive.space.8}" }
    }
  }
}